PORT=4000
HOST=0.0.0.0
# Production: random string of 32+ characters (required when NODE_ENV=production)
JWT_SECRET=change-this-secret
# Allowed frontend origins, comma separated; "*" is allowed as a subdomain wildcard
CORS_ORIGIN=*
# NODE_ENV=production

# First administrator, created only when the production database is empty
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@college.local
# ADMIN_PASSWORD=

# Optional storage settings
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
# BACKUP_DIR=./data/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# TRUST_PROXY=1
